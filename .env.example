# Flask & Environment
FLASK_ENV=production
FLASK_DEBUG=false

# Paths
UPLOAD_FOLDER=Images
REPORTS_FOLDER=reports

# Tenancy (single for now, multi later)
TENANT_MODE=single
DEFAULT_TENANT=default

# Processing
BATCH_SIZE_MAX=8
THERMAL_SENSITIVITY=medium

# Logging
LOG_LEVEL=ERROR
LOG_FILE=thermal_report_errors.log

# ============================================================================
# Survey Organisation Details (customise for your org)
# ============================================================================
ORG_NAME=Your Survey Organisation Name
ORG_WEBSITE=https://yourwebsite.com
ORG_CONTACT=contact@yourorg.com
REPORT_FILENAME_SUFFIX=thermal_survey_report

# ============================================================================
# Storage Backend
# ============================================================================
STORAGE_TYPE=local
STORAGE_ADDRESS=
STORAGE_ACCESS_KEY=

# Google Drive folder ID for source images (used by /list_folders)
# STORAGEADDRESS=<folder_id>

# ============================================================================
# Google Drive Output Folder
# The saved report PDF is uploaded here when the surveyor clicks
# "Save report to output". Set to the Drive folder ID from your folder URL.
# e.g. https://drive.google.com/drive/folders/<ID> -> use the <ID> part only
# ============================================================================
PDF_STORAGE_ADDRESS=1NPEogQmCYwxLOC34mgPoQOizXLzo-WcO

# ============================================================================
# Recommendations & Resources
# ============================================================================
# ORGNAME="Acme Thermal Surveys"
# ORGWEBSITE="https://acmethermal.co.uk"
# ORGCONTACT="info@acmethermal.co.uk"
# RECOMMENDATIONS_DOCUMENT_URL="https://drive.google.com/..."
