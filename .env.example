# Flask & Environment
FLASK_ENV=production
FLASK_DEBUG=false

# Paths
UPLOAD_FOLDER=Images
REPORTS_FOLDER=reports

# Tenancy (single for now, multi later)
TENANT_MODE=single
DEFAULT_TENANT=default

# Processing
BATCH_SIZE_MAX=8
THERMAL_SENSITIVITY=medium

# Logging
LOG_LEVEL=ERROR
LOG_FILE=thermal_report_errors.log

# ============================================================================
# Survey Organisation Details (customise for your org)
# ============================================================================
ORG_NAME=Your Survey Organisation Name
ORG_WEBSITE=https://yourwebsite.com
ORG_CONTACT=contact@yourorg.com
REPORT_FILENAME_SUFFIX=thermal_survey_report

# ============================================================================
# Storage Backend (local for now, Google Drive / S3 config for future)
# ============================================================================
STORAGE_TYPE=local
STORAGE_ADDRESS=
STORAGE_ACCESS_KEY=

# Example Google Drive setup (when implemented):
# STORAGE_TYPE=google_drive
#
# IMPORTANT: For the /list_folders feature, set STORAGE_ADDRESS to your parent folder ID.
# This is the folder containing all the survey folders you want to process.
# The 'Drive →' button on the homepage will list all sub-folders within this parent folder.
# Example: If your parent folder URL is https://drive.google.com/drive/folders/1Abc123xyz
# Then set: STORAGE_ADDRESS=1Abc123xyz
# STORAGE_ADDRESS=YOUR_PARENT_FOLDER_ID_HERE
# STORAGE_ACCESS_KEY=/path/to/service-account-key.json
